# Path to Zebra/Zakura's RocksDB state directory
ZEBRA_STATE_PATH=~/.cache/zebra/state/v29/mainnet
DATABASE_URL=postgres://zcash_user:replace_me@127.0.0.1:5432/zcash_explorer_mainnet
NETWORK=mainnet
BATCH_SIZE=1000

# RocksDB tuning (default: 256)
# MAX_OPEN_FILES=256

# Maximum automatic reorg depth and recent-block spool retention (default: 1000,
# matching the node's rollback limit)
# MAX_REORG_DEPTH=1000

# Live-mode: Zebra/Zakura JSON-RPC endpoint
ZEBRA_RPC_URL=http://127.0.0.1:8232
ZEBRA_RPC_COOKIE_FILE=~/.cache/zebra/.cookie

# Live-mode: Zebra/Zakura gRPC indexer endpoint (optional)
# ZEBRA_GRPC_URL=http://127.0.0.1:8230
# Keep false until `cipherscan-indexer shadow` passes against the deployed node.
# ENABLE_FULL_BLOCK_GRPC=false
# GRPC_PAYLOAD_CACHE_BLOCKS=32
# GRPC_PAYLOAD_CACHE_BYTES=67108864
# GRPC_PAYLOAD_WAIT_MS=1500
# BLOCK_SPOOL_PATH=/var/lib/cipherscan-indexer/block-spool
# LIVE_PIPELINE_CAPACITY=4

# Optional health alerts via Telegram
# TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
# TELEGRAM_CHAT_ID=YOUR_CHAT_ID
# INDEXER_MAX_LAG=3
# INDEXER_MAX_CONSECUTIVE_FAILURES=0
# INDEXER_MAX_HEARTBEAT_AGE_SECONDS=600
# INDEXER_MAX_INGEST_MS=5000
# INDEXER_ALERT_COOLDOWN_SECONDS=1800

# Emergency rollback only: set to any value to restore per-row SQL writes.
# CIPHERSCAN_ROWWISE_WRITES=1

# Fallback tip polling (seconds, clamped to 1..60); gRPC remains immediate.
LIVE_POLL_INTERVAL_SECONDS=5
