# Append to /etc/wireguard/wg0.conf on EACH fleet host (example only).
# Hosts that are not on WireGuard yet first need an [Interface] with their
# planned address (README "Address plan"), e.g.:
#   [Interface]
#   Address = 10.77.0.N/24
#   ListenPort = 51820
#   PostUp = wg set %i private-key /etc/wireguard/host.key
# Observers already have wg0 with the primary peer; only add the block below.
#
# The monitor may reach only this host's own wg address; UFW then allows
# 9100/tcp (and 9999/tcp for Zakura, once verified) only from 10.77.0.10 on wg0.
[Peer]
# zecblock monitor
PublicKey = <monitor wg public key from /etc/wireguard/monitor.pub>
AllowedIPs = 10.77.0.10/32
Endpoint = <monitor public address>:51820
PersistentKeepalive = 25
