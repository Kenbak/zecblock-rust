# Pinned monitor-box releases (linux-amd64). The installer refuses any artifact
# whose SHA-256 differs. SHA-256 values were copied 2026-11-05 from each
# project's published sha256sums.txt (Prometheus/Alertmanager) and the
# grafana.com downloads API (Grafana OSS .deb). Re-verify when bumping.
#
# Alertmanager 0.34.2 and Grafana 13.2.5 are security releases (CORS default,
# Go 1.26.10 CA distrust / four Grafana CVEs), chosen over older pins.
PROMETHEUS_VERSION=3.15.1
PROMETHEUS_SHA256=6a726885328ad9efebbf36e876ce2fb6225468a71fd1e7ce3ba666d5f4d97a84
PROMETHEUS_URL=https://github.com/prometheus/prometheus/releases/download/v3.15.1/prometheus-3.15.1.linux-amd64.tar.gz

ALERTMANAGER_VERSION=0.34.2
ALERTMANAGER_SHA256=17ee14acd0f6ba6e25a436ff223d9c17ddd5cf484f543ad12f0932eaa89ba186
ALERTMANAGER_URL=https://github.com/prometheus/alertmanager/releases/download/v0.34.2/alertmanager-0.34.2.linux-amd64.tar.gz

GRAFANA_VERSION=13.2.5
GRAFANA_SHA256=3c8d7874f2e14120044c3f131a47c25bd9412e449f9037e298bc6419630c73b7
GRAFANA_URL=https://dl.grafana.com/grafana/release/13.2.5/grafana_13.2.5_40359240686_linux_amd64.deb

# Fleet hosts use Ubuntu 24.04's prometheus-node-exporter package (security
# updates via unattended-upgrades), bound to the host's wg address.
